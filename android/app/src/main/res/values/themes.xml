<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose handles all theming; this XML theme is only for the window background
         and status bar before Compose takes over. AppCompat.NoActionBar is safe with
         the appcompat dependency we already have. -->
    <style name="Theme.SilaCalc" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimary">@color/primary</item>
    </style>
</resources>
